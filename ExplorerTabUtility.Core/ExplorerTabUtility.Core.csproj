<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ExplorerTabUtility</RootNamespace>
    <AssemblyName>ExplorerTabUtility.Core</AssemblyName>
    <!-- 平台跟着宿主走：Platform=ARM64 时编成 ARM64，其余情况（含不带 -p:Platform 的
         AnyCPU 默认）保持 x64 —— 因此现有 CI、release.py 与安装器链路完全不受影响。

         为什么必须是"跟着走"而不是写死一个值：Core 同时被 x64 外壳引用（发布用的是
         win-x64），所以它一旦写死成另一个架构，就会在 x64 发布包里出现
         "x64 的 ExplorerTabUtility.dll + ARM64 的 ExplorerTabUtility.Core.dll"，
         构建期只报一条 CS8012 警告（publish 不带 -warnaserror，release.py 的三道校验
         也查不出架构不一致），运行时才以 BadImageFormatException 炸在用户机器上。 -->
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'ARM64'">x64</PlatformTarget>
    <!-- Core 是独立程序集，其程序集版本与产品版本（根 Directory.Build.props 的 <AppVersion>）有意分开：
         它不代表对外发布的产品版本号，请勿改来"对齐"。 -->
    <Version>3.0.0</Version>
    <Authors>saillill</Authors>
    <Description>ExplorerTabUtility 业务内核 — 零 UI 框架依赖，可同时被 WPF 与 WinUI 3 外壳引用。</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- SatelliteResourceLanguages 已上移到根 Directory.Build.props；该列表必须与本项目的
         Resources.<code>.resx 保持对齐，否则卫星程序集会被生成却不会复制到发布目录。 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.Hooks" Version="1.7.0" />
    <!-- 保留原有的 IL 织入语义：全量注入 ConfigureAwait(false)。
         后续可逐步显式化并移除，见重构方案阶段 0 说明。

         ⚠️ 这是一条**进程级线程语义契约**，由 ExplorerTabUtility.Tests 的两条测试守着：
           · Core 的 await 续体不得回到调用方的 SynchronizationContext（即织入必须生效）；
           · App 外壳**不得**被织入（它的续体要留在 UI 线程上，AboutPage 的图片缓存依赖这一点）。
         改动本文件或 FodyWeavers.xml 前先读 docs/ARCHITECTURE.md「线程交付模型」。
         移除织入不是不可以，但必须把 Core 里需要脱离上下文的 await 显式化，
         并同步删掉那两条测试的期望值 —— 否则 UI 线程会被无谓地拉回。 -->
    <PackageReference Include="Fody" Version="6.9.2" PrivateAssets="all" />
    <PackageReference Include="ConfigureAwait.Fody" Version="3.3.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 单元测试需要触碰两个内部实现：SettingsManager.WriteAtomic（原子写 + .bak 回滚）
         与 AppSettings（写入对象）。仅暴露给测试程序集，不改变公开面。 -->
    <InternalsVisibleTo Include="ExplorerTabUtility.Tests" />
  </ItemGroup>

</Project>
