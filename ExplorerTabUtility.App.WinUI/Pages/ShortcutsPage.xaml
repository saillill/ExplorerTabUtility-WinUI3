<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExplorerTabUtility.App.Pages.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <!--
        原 WPF 版的 "快捷键" 页由下列自绘元素构成，现全部移除：
          · 自绘抽屉 + 60 行 CubicEase 宽度动画      → NavigationView 面板
          · NavigationList(ListBox) + TabControl 同步 → NavigationView + Frame
          · FlatButtonStyle / CustomCheckBoxStyle    → 默认 Button / ToggleSwitch / AccentButtonStyle

        整页放进同一个 ScrollViewer：标题、工具栏与卡片列表共用同一条内容列。
        宽度完全交给布局引擎（Stretch），不计算具体像素值 —— 计算值一旦与实际视口脱节就会溢出，
        而 Stretch 在结构上不可能超出视口。

        ⛔ 不要再给它加 MaxWidth。2026-10-01 试过 MaxWidth="1000"（想在大屏上封顶），
        实测「Stretch + MaxWidth」在这个 ScrollViewer 里会把被限宽的列**摆到视口之外**：
        1500 epx 窗口下 colX=643、colW=1000，而内容视口只有 1173 ⇒ 卡片右半（开关与展开箭头）
        被裁出屏幕。把边距从列挪到 ScrollViewer.Padding 同样无效。
        真要封顶得换做法（例如按视口宽度在代码里设 ContentColumn.Width），别在 XAML 里加 MaxWidth。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel
            x:Name="ContentColumn"
            Spacing="4"
            Margin="36,24,36,24"
            HorizontalAlignment="Stretch">

            <TextBlock x:Name="HeaderTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="HeaderSubtitle"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <Grid ColumnSpacing="16" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnNewProfile" Style="{StaticResource AccentButtonStyle}" Click="OnNewProfileClick" />
                    <Button x:Name="BtnImport" Click="OnImportClick" />
                    <Button x:Name="BtnExport" Click="OnExportClick" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="ProfilesPanel" Spacing="4" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
