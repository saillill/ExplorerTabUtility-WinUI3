<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExplorerTabUtility.App.Pages.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <!--
        原 WPF 版的 "快捷键" 页由下列自绘元素构成，现全部移除：
          · 自绘抽屉 + 60 行 CubicEase 宽度动画      → NavigationView 面板
          · NavigationList(ListBox) + TabControl 同步 → NavigationView + Frame
          · FlatButtonStyle / CustomCheckBoxStyle    → 默认 Button / ToggleSwitch / AccentButtonStyle

        整页放进同一个 ScrollViewer：标题、工具栏与卡片列表共用同一条内容列。
        宽度完全交给布局引擎（Stretch + MaxWidth），不计算具体像素值 —— 计算值一旦与实际视口
        脱节就会溢出，而 Stretch 在结构上不可能超出视口。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel
            x:Name="ContentColumn"
            Margin="36,24,36,24"
            Spacing="4"
            HorizontalAlignment="Stretch">

            <TextBlock x:Name="HeaderTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="HeaderSubtitle"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <Grid ColumnSpacing="16" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnNewProfile" Style="{StaticResource AccentButtonStyle}" Click="OnNewProfileClick" />
                    <Button x:Name="BtnImport" Click="OnImportClick" />
                    <Button x:Name="BtnExport" Click="OnExportClick" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="ProfilesPanel" Spacing="4" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
