<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExplorerTabUtility.App.Pages.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <!--
        原 WPF 版设置页 = GroupBox(WinUI 3 无此控件) + 4 个自定义 CheckBox + 自定义 ComboBox 样式。
        现改为 Windows 官方设置页范式：SettingsCard 列表 + ToggleSwitch + 默认 ComboBox。

        布局：整列设置卡片水平居中（宽度由 ContentColumnWidth 计算，上限 1000）；
        卡片内部的标题与说明仍由 SettingsCard 保持左对齐。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel
            x:Name="ContentColumn"
            Spacing="4"
            Margin="36,24,36,24"
            HorizontalAlignment="Stretch">

            <TextBlock x:Name="HeaderTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="HeaderSubtitle"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,16"
                TextWrapping="Wrap" />

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardTheme">
                <ComboBox x:Name="CbTheme" MinWidth="200" SelectionChanged="OnThemeChanged" />
            </controls:SettingsCard>

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardLanguage">
                <ComboBox x:Name="CbLanguage" MinWidth="200" SelectionChanged="OnLanguageChanged" />
            </controls:SettingsCard>

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardSaveClosedHistory">
                <ToggleSwitch x:Name="SwSaveClosedHistory"
                              Toggled="OnSaveClosedHistoryToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardRestorePreviousWindows">
                <ToggleSwitch x:Name="SwRestorePreviousWindows"
                              Toggled="OnRestorePreviousWindowsToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardHideTrayIcon">
                <ToggleSwitch x:Name="SwHideTrayIcon"
                              Toggled="OnHideTrayIconToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardStartup">
                <ToggleSwitch x:Name="SwStartup"
                              Toggled="OnStartupToggled" />
            </controls:SettingsCard>

            <!-- 自启的子选项：由系统启动项拉起时不显示主窗口，只在托盘运行 -->
            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardHideWindowOnStartup">
                <ToggleSwitch x:Name="SwHideWindowOnStartup"
                              Toggled="OnHideWindowOnStartupToggled" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
