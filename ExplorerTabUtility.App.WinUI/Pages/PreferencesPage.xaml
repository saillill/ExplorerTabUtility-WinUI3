<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExplorerTabUtility.App.Pages.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <!--
        原 WPF 版设置页 = GroupBox(WinUI 3 无此控件) + 4 个自定义 CheckBox + 自定义 ComboBox 样式。
        现改为 Windows 官方设置页范式：SettingsCard 列表 + ToggleSwitch + 默认 ComboBox。

        布局：整列设置卡片撑满内容列，卡片内部的标题与说明保持左对齐。

        ⛔ 不要给这一列加 MaxWidth —— 见 ShortcutsPage 上方的实测说明：
        「Stretch + MaxWidth」会把被限宽的列摆到视口之外，卡片右侧控件被裁掉。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel
            x:Name="ContentColumn"
            Spacing="4"
            Margin="36,24,36,24"
            HorizontalAlignment="Stretch">

            <TextBlock x:Name="HeaderTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="HeaderSubtitle"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,16"
                TextWrapping="Wrap" />

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardTheme">
                <ComboBox x:Name="CbTheme" MinWidth="200" SelectionChanged="OnThemeChanged" />
            </controls:SettingsCard>

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardLanguage">
                <ComboBox x:Name="CbLanguage" MinWidth="200" SelectionChanged="OnLanguageChanged" />
            </controls:SettingsCard>

            <!--
                一个开关，说的是用户看得到的行为（新窗口要不要并成标签页），而不是底层两个机制。
                之前这里是"标签复用"和"窗口拦截"两张卡：它们是同一个行为的两个开关，任何一张开着都会
                折叠新窗口，所以两张卡的文字读起来必然像在说同一件事 —— 那不是文案问题，是两个开关本就多余。
            -->
            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardMergeNewWindows">
                <ToggleSwitch x:Name="SwMergeNewWindows" Toggled="OnMergeNewWindowsToggled" />
            </controls:SettingsCard>

            <!--
                不合并的文件夹，按 Windows 自己的库位置那种排版：标题行右侧是带文字的按钮，展开后
                每个文件夹一行 —— 路径在左、移除按钮在右。行在代码里生成（路径是数据）。
            -->
            <controls:SettingsExpander
                x:Name="CardNoMergeFolders"
                HorizontalAlignment="Stretch"
                IsExpanded="False">
                <!--
                    Direct content, not ItemsHeader: on a SettingsExpander the card's own content slot is the
                    trailing side of the header row — the place Windows puts "添加文件夹" on its library-
                    locations card. ItemsHeader is the caption above the item list, which put the button on a
                    row of its own under the title.
                -->
                <Button x:Name="BtnAddNoMergeFolder" Click="OnAddNoMergeFolderClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                        <TextBlock x:Name="AddNoMergeFolderText" />
                    </StackPanel>
                </Button>
            </controls:SettingsExpander>

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardSaveClosedHistory">
                <ToggleSwitch x:Name="SwSaveClosedHistory"
                              Toggled="OnSaveClosedHistoryToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardRestorePreviousWindows">
                <ToggleSwitch x:Name="SwRestorePreviousWindows"
                              Toggled="OnRestorePreviousWindowsToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardHideTrayIcon">
                <ToggleSwitch x:Name="SwHideTrayIcon"
                              Toggled="OnHideTrayIconToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardStartup">
                <ToggleSwitch x:Name="SwStartup"
                              Toggled="OnStartupToggled" />
            </controls:SettingsCard>

            <!-- 自启的子选项：由系统启动项拉起时不显示主窗口，只在托盘运行 -->
            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardHideWindowOnStartup">
                <ToggleSwitch x:Name="SwHideWindowOnStartup"
                              Toggled="OnHideWindowOnStartupToggled" />
            </controls:SettingsCard>

            <!--
                自动更新，放在整页最下面 —— 它是关于这个程序本身的事，与上面这些"程序怎么工作"的设置不同。
                形状与其它行一致：右边是布尔开关；开关左边多一个「现在检测」按钮，手动查一次。
                查出新版本后按钮变成「下载并安装」，下载时按钮让位给进度条（同一格切换，行高不跳）。
            -->
            <controls:SettingsCard HorizontalAlignment="Stretch" x:Name="CardUpdate">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="BtnUpdate" Click="OnUpdateButtonClick" MinWidth="110" />
                        <ToggleSwitch x:Name="SwAutoUpdate" Toggled="OnAutoUpdateToggled" />
                    </StackPanel>
                    <ProgressBar x:Name="UpdateProgress" Width="240" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
