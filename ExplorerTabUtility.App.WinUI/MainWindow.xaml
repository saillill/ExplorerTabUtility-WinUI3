<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ExplorerTabUtility.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        自定义标题栏 + 官方 NavigationView。

        与 WPF 版的差异（均为"删除自绘"的结果）：
          · 没有 WindowStyle=None / AllowsTransparency / 自绘标题栏 / 三个自绘窗口按钮
            → 改为 ExtendsContentIntoTitleBar：应用内容延伸到系统标题栏区域，
              最小化/最大化/关闭仍由系统绘制，位于同一行的最右侧
          · 没有手写抽屉动画（60 行 Storyboard）—— NavigationView 内置面板动画
          · 没有 NavigationList(TextBox) + TabControl 双控件同步 —— NavigationView + Frame
          · 没有 StatuBar 的椭圆指示灯与 DropShadowEffect 发光

        标题栏排布（同一行）：[缩放侧栏] [应用名称] ............ [最小化][最大化][关闭]
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- NavigationView 自带的面板开关已隐藏，改由这里控制，以便与窗口按钮同处一行 -->
            <Button x:Name="BtnPaneToggle"
                    Grid.Column="0"
                    Width="40"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPaneToggleClick">
                <FontIcon Glyph="&#xE700;" FontSize="14" />
            </Button>

            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="2,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            AlwaysShowHeader="False"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavShortcuts" Tag="Shortcuts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" FontSize="16" Width="16" VerticalAlignment="Center" Margin="0,2,0,0" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavPreferences" Tag="Preferences">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontSize="16" Width="16" VerticalAlignment="Center" Margin="0,2,0,0" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <!--
                    三个导航项一律使用控件默认的状态底色，不在此覆盖任何 NavigationViewItemBackground*。

                    曾经把这一项（且只有这一项）的选中/悬停/按下/禁用底色全部覆盖成 Transparent，
                    为了去掉"像个按钮"的底色块。两个问题让它被撤销：
                      · 同一组导航项里只有它没有选中背板 —— 选中态不一致，而"选中必须可感知"是无障碍硬要求；
                      · Disabled 也被覆盖成透明 → 禁用态完全不可见。
                    换句话说，它不再是"官方轻量样式"，而是用覆盖资源替换了控件自身的状态视觉语言。
                    如果认为默认背板偏重，正确做法是三项一起调（统一 Style / 主题资源），不是只把一项改透明。
                -->
                <NavigationViewItem x:Name="NavAbout" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontSize="16" Width="16" VerticalAlignment="Center" Margin="0,2,0,0" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
