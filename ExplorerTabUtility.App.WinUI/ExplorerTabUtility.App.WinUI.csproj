<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ExplorerTabUtility.App</RootNamespace>
    <AssemblyName>ExplorerTabUtility</AssemblyName>
    <ApplicationIcon>Assets\Icon.ico</ApplicationIcon>

    <!-- 版本号单一来源：产品版本定义在根 Directory.Build.props 的 <AppVersion>，
         公共属性 Nullable/LangVersion/ImplicitUsings/SatelliteResourceLanguages 亦在该文件统一声明。 -->
    <Version>$(AppVersion)</Version>
    <!-- 双平台，x64 仍是默认发布目标。
         不带 -p:Platform 时 Platform 为 AnyCPU，落到下面的 x64 分支，走的是与过去完全相同的
         win-x64；ARM64 是**新增的一条腿**（-p:Platform=ARM64 → win-arm64），
         而不是替换 —— 替换会让 release.py（硬编码 -r win-x64）与安装器链路一起断掉。
         安装器侧 ArchitecturesAllowed=x64compatible arm64 原本就放行 arm64 机器，
         即 ARM64 设备上的默认体验仍是"跑 x64 版"，原生 ARM64 是额外可选产物。 -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>

    <!-- 非打包（unpackaged）模型：保留 HKCU Run 开机自启、便携 zip 与现有安装器链路 -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- 默认自包含（免装 Windows App Runtime）。
         两者都写成"未指定才赋值"，因此命令行可用
         -p:SelfContained=false -p:WindowsAppSDKSelfContained=false 切到框架依赖模式。 -->
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>

    <!-- 由 Program.cs 接管入口，以便在创建任何 XAML 对象前完成单实例判定 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- 生成 WinUI 3 所需的 COM/WinRT 互操作支持 -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <UseWinUI>true</UseWinUI>

    <!-- SatelliteResourceLanguages 已上移到根 Directory.Build.props：该列表必须与
         LocalizationService.SupportedLanguages 及 Core 里的 Resources.<code>.resx 保持对齐，
         否则卫星程序集会被生成却不复制到发布目录（表现为"选了某语言但还是英文"）。 -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- 发布产物不需要符号文件，与原 CI 的 /p:DebugType=none 一致 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 托盘图标：WinUI 3 没有原生托盘控件，H.NotifyIcon 是同生态（H.Hooks 作者）的官方推荐替代。
         版本刻意跟着 2.5.0 的预发布：主题化的原生菜单（ContextMenuThemeMode / PopupMenuThemeMode）
         只在 2.5.0-beta.3 及以后（上游 PR #265），而 2.4.1 的 SecondWindow 模式在本机 175% 缩放下
         会把菜单窗口算窄约一半（文字被截断）。2.5.0 出正式版后应升级到它。 -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.5.0-beta.3" />
    <!-- 独立窗口里的 ContentDialog：WinUI 3 没有"对话框自己的窗口"这种控件，社区里成熟且仍在维护的做法是
         SuGar0218/WindowedContentDialog（MIT，包名 SuGarToolkit.Controls.Dialogs）。它把三件原先在这里手写、
         且每一件都写错了的事做对了：
           * 尺寸用 ResizeClient 并把 30 DIP 标题栏从高度里扣掉 —— 它自己的注释写明 AppWindow.Resize 不准、
             内容延伸到标题栏时 ResizeClient 高度会多算，这正是"文字被截断"的成因；
           * 用 SetTitleBar(卡片标题区) 让系统拖动 —— 不需要可见标题栏（伪造 WM_NCLBUTTONDOWN 在 WinUI 3 上
             只在松开时拖动，见 StackOverflow 79078428）；
           * 无 owner 时居中到显示器。
         代价是多一个依赖；收益是与手写窗口相关的一整类问题（尺寸/拖动/取消/关闭）不再由本项目承担。 -->
    <PackageReference Include="SuGarToolkit.Controls.Dialogs" Version="2.1.1" />
    <!-- SystemEvents.SessionEnding：WinUI 的 Application 没有 SessionEnding 事件 -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExplorerTabUtility.Core\ExplorerTabUtility.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 必须显式 CopyToOutputDirectory：托盘与 AppWindow 都按绝对路径读这个文件，
         不设置的话它不会进入 bin/ 与 publish/ 目录。 -->
    <Content Include="Assets\Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <!-- 关于页的开发者/赞助者名单与头像随应用一起分发：此前每次首访都要联网取 SVG、再下载并解码头像，
         所以名单要等到第二次进入才显示完，头像也每次都像在重新加载。头像由 SVG 内嵌的 WebP 转成 PNG
         （WinUI 没有 WebP 编解码器，原始 payload 永远解不出来），因此本地这一份既能离线用、也一定能显示。 -->
    <Content Include="Assets\Supporters.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Supporters\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>

  <!--
    dotnet publish 不会把应用自己的 ExplorerTabUtility.pri 复制到 publish 目录，
    而它正是编译后 XAML（XBF）的载体。缺失时 MainWindow.InitializeComponent 会在运行时抛
    XamlParseException（表现为"窗口打不开、托盘图标随即消失"）。
    构建输出 bin/ 里该文件是正常生成的，只是没随 publish 走，这里补上。
  -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish" Condition="Exists('$(OutputPath)$(AssemblyName).pri')">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
